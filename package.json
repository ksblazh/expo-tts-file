{
  "name": "expo-tts-file",
  "version": "0.2.1",
  "description": "On-device text-to-speech synthesized to an audio file (offline TTS-to-file for React Native / Expo).",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "src/*.ts",
    "ios",
    "android/build.gradle",
    "android/src/main",
    "expo-module.config.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "check:versions": "node internal/module_scripts/check-versions.js",
    "check:package": "node internal/module_scripts/check-package.js",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "prepublishOnly": "node internal/module_scripts/check-package.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "tts",
    "text-to-speech",
    "speech-synthesis",
    "offline",
    "audio",
    "expo-module"
  ],
  "repository": "https://github.com/ksblazh/expo-tts-file",
  "bugs": {
    "url": "https://github.com/ksblazh/expo-tts-file/issues"
  },
  "author": "Kseniia Blazhkovskaia <ksblazh@gmail.com> (https://github.com/ksblazh)",
  "license": "MIT",
  "homepage": "https://github.com/ksblazh/expo-tts-file#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^56.0.19",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^56.0.11",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "prettier": "^3.0.0",
    "react-native": "0.85.3",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "overrides": {
    "@react-native/codegen": "0.85.3",
    "@react-native/babel-plugin-codegen": "0.85.3"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
