# Deny by default: git sees nothing that is not opened below. Scratch notes, editor and
# assistant state, machine-local config and build output stay invisible without this file
# naming them one by one — so a new kind of stray file is covered the day it appears,
# rather than the day someone remembers to add a line for it.
/*

!/.github/
!/android/
!/example/
!/internal/
!/ios/
!/src/

!/.gitignore
!/.prettierrc
!/CHANGELOG.md
!/LICENSE
!/README.md
!/eslint.config.cjs
!/expo-module.config.json
!/package-lock.json
!/package.json
!/tsconfig.json

# Generated inside the directories opened above.
/android/.cxx/
/android/.gradle/
/android/build/
/android/local.properties

# Opening a directory re-admits everything inside it, so what must never be committed
# anywhere is stated globally rather than per directory.
.DS_Store
*.orig.*
*.tsbuildinfo
.kotlin/
xcuserdata/
*.xcuserstate

# Signing material and local environment — never, at any depth.
*.jks
*.key
*.keystore
*.mobileprovision
*.p8
*.p12
*.pem
.env*.local
